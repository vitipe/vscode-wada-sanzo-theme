{
  "$schema": "vscode://schemas/color-theme",
  "name": "Wada Sanzō - Komorebi (Té Verde & Bosque)",
  "type": "dark",
  "colors": {
    "focusBorder": "#EAC64588",
    "foreground": "#E4E1D7",
    "widget.shadow": "#00000066",
    "selection.background": "#37423D",
    "descriptionForeground": "#868F89",
    "errorForeground": "#E25D4A",

    "editor.background": "#212523",
    "editor.foreground": "#E4E1D7",
    "editorLineNumber.foreground": "#5B6660",
    "editorLineNumber.activeForeground": "#EAC645",
    "editorCursor.foreground": "#E25D4A",
    "editorCursor.background": "#212523",
    "editor.selectionBackground": "#37423DAA",
    "editor.inactiveSelectionBackground": "#2B332F88",
    "editor.selectionHighlightBackground": "#37423D55",
    "editor.wordHighlightBackground": "#EAC64522",
    "editor.wordHighlightStrongBackground": "#EAC64533",
    "editor.findMatchBackground": "#EAC64544",
    "editor.findMatchHighlightBackground": "#6CB5E833",
    "editor.findRangeHighlightBackground": "#37423D33",
    "editor.hoverHighlightBackground": "#2A2F2C",
    "editor.lineHighlightBackground": "#2A2F2C",
    "editor.lineHighlightBorder": "#00000000",
    "editorLink.activeForeground": "#6CB5E8",
    "editorWhitespace.foreground": "#343D38",
    "editorIndentGuide.background1": "#2B332F",
    "editorIndentGuide.activeBackground1": "#4A5952",
    "editorRuler.foreground": "#2B332F",
    "editorBracketMatch.background": "#37423D",
    "editorBracketMatch.border": "#6CB5E8",
    "editorGutter.background": "#212523",
    "editorGutter.modifiedBackground": "#EAC645",
    "editorGutter.addedBackground": "#55C595",
    "editorGutter.deletedBackground": "#E25D4A",

    "activityBar.background": "#151816",
    "activityBar.foreground": "#EAC645",
    "activityBar.inactiveForeground": "#5B6660",
    "activityBar.border": "#323935",
    "activityBarBadge.background": "#E25D4A",
    "activityBarBadge.foreground": "#FFFFFF",

    "sideBar.background": "#1A1D1B",
    "sideBar.foreground": "#B5BFB9",
    "sideBar.border": "#323935",
    "sideBarTitle.foreground": "#E4E1D7",
    "sideBarSectionHeader.background": "#1A1D1B",
    "sideBarSectionHeader.foreground": "#E4E1D7",
    "sideBarSectionHeader.border": "#323935",

    "tab.activeBackground": "#212523",
    "tab.activeForeground": "#E4E1D7",
    "tab.activeBorderTop": "#EAC645",
    "tab.inactiveBackground": "#1A1D1B",
    "tab.inactiveForeground": "#868F89",
    "tab.border": "#323935",
    "tab.hoverBackground": "#252B28",
    "tab.unfocusedActiveBackground": "#212523",
    "tab.unfocusedActiveForeground": "#B5BFB9",
    "tab.unfocusedInactiveForeground": "#656E68",
    "editorGroupHeader.tabsBackground": "#1A1D1B",
    "editorGroupHeader.tabsBorder": "#323935",
    "editorGroup.border": "#323935",

    "statusBar.background": "#1A1D1B",
    "statusBar.foreground": "#B5BFB9",
    "statusBar.border": "#323935",
    "statusBar.debuggingBackground": "#E25D4A",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#1A1D1B",
    "statusBarItem.hoverBackground": "#2A2F2C",
    "statusBarItem.remoteBackground": "#EAC645",
    "statusBarItem.remoteForeground": "#151816",

    "titleBar.activeBackground": "#1A1D1B",
    "titleBar.activeForeground": "#B5BFB9",
    "titleBar.inactiveBackground": "#151816",
    "titleBar.inactiveForeground": "#656E68",
    "titleBar.border": "#323935",

    "menu.background": "#212523",
    "menu.foreground": "#E4E1D7",
    "menu.selectionBackground": "#2B332F",
    "menu.selectionForeground": "#EAC645",
    "menu.separatorBackground": "#323935",
    "menu.border": "#323935",

    "quickInput.background": "#212523",
    "quickInput.foreground": "#E4E1D7",
    "pickerGroup.border": "#323935",
    "pickerGroup.foreground": "#EAC645",

    "list.activeSelectionBackground": "#2B332F",
    "list.activeSelectionForeground": "#EAC645",
    "list.inactiveSelectionBackground": "#242A27",
    "list.inactiveSelectionForeground": "#E4E1D7",
    "list.hoverBackground": "#242A27",
    "list.focusBackground": "#2B332F",
    "list.highlightForeground": "#EAC645",

    "input.background": "#1A1D1B",
    "input.foreground": "#E4E1D7",
    "input.border": "#3B453F",
    "input.placeholderForeground": "#656E68",
    "inputOption.activeBorder": "#EAC645",

    "badge.background": "#EAC645",
    "badge.foreground": "#151816",

    "button.background": "#E25D4A",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#CE4F3D",
    "button.secondaryBackground": "#2B332F",
    "button.secondaryForeground": "#E4E1D7",
    "button.secondaryHoverBackground": "#37423D",

    "dropdown.background": "#1A1D1B",
    "dropdown.foreground": "#E4E1D7",
    "dropdown.border": "#3B453F",

    "terminal.background": "#1A1D1B",
    "terminal.foreground": "#E4E1D7",
    "terminal.ansiBlack": "#212523",
    "terminal.ansiRed": "#E25D4A",
    "terminal.ansiGreen": "#55C595",
    "terminal.ansiYellow": "#EAC645",
    "terminal.ansiBlue": "#6CB5E8",
    "terminal.ansiMagenta": "#D59CE8",
    "terminal.ansiCyan": "#5DC4B3",
    "terminal.ansiWhite": "#E4E1D7",
    "terminal.ansiBrightBlack": "#5B6660",
    "terminal.ansiBrightRed": "#ED7362",
    "terminal.ansiBrightGreen": "#73D4A9",
    "terminal.ansiBrightYellow": "#F2D563",
    "terminal.ansiBrightBlue": "#87C5F0",
    "terminal.ansiBrightMagenta": "#E0B3F0",
    "terminal.ansiBrightCyan": "#78D4C5",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "gitDecoration.modifiedResourceForeground": "#EAC645",
    "gitDecoration.deletedResourceForeground": "#E25D4A",
    "gitDecoration.untrackedResourceForeground": "#55C595",
    "gitDecoration.ignoredResourceForeground": "#5B6660",
    "gitDecoration.conflictingResourceForeground": "#FA946B",
    "diffEditor.insertedTextBackground": "#55C5951F",
    "diffEditor.removedTextBackground": "#E25D4A1F",

    "breadcrumb.foreground": "#868F89",
    "breadcrumb.focusForeground": "#E4E1D7",
    "breadcrumb.activeSelectionForeground": "#EAC645",
    "breadcrumbCurrentItem.foreground": "#EAC645",

    "scrollbarSlider.background": "#37423D44",
    "scrollbarSlider.hoverBackground": "#37423D77",
    "scrollbarSlider.activeBackground": "#EAC64566",

    "notificationCenterHeader.background": "#1A1D1B",
    "notifications.background": "#212523",
    "notifications.border": "#323935",
    "notificationLink.foreground": "#6CB5E8"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7B877F", "fontStyle": "italic" }
    },
    {
      "name": "Keywords & Control",
      "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#E25D4A", "fontStyle": "bold" }
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.method"],
      "settings": { "foreground": "#EAC645" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#55C595" }
    },
    {
      "name": "String Escapes & Interpolation",
      "scope": ["constant.character.escape", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#D59CE8" }
    },
    {
      "name": "Numbers & Booleans",
      "scope": ["constant.numeric", "constant.language.boolean", "constant.language.null", "constant.language.undefined"],
      "settings": { "foreground": "#FA946B" }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "entity.name.struct", "entity.name.enum", "support.type", "support.class"],
      "settings": { "foreground": "#6CB5E8", "fontStyle": "bold" }
    },
    {
      "name": "Variables & Parameters",
      "scope": ["variable", "variable.other", "variable.other.readwrite", "variable.parameter"],
      "settings": { "foreground": "#E4E1D7" }
    },
    {
      "name": "Properties & Object Keys",
      "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#76AEC7" }
    },
    {
      "name": "Operators & Delimiters",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.definition.parameters"],
      "settings": { "foreground": "#D59CE8" }
    },
    {
      "name": "Brackets & Curly braces",
      "scope": ["punctuation.brackets", "punctuation.definition.bracket", "meta.brace"],
      "settings": { "foreground": "#B5BFB9" }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#E25D4A" }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#EAC645" }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#6CB5E8" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#EAC645", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#E25D4A", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#FA946B", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": { "foreground": "#55C595" }
    },
    {
      "name": "Markdown Links",
      "scope": ["string.other.link.title.markdown", "markup.underline.link"],
      "settings": { "foreground": "#6CB5E8" }
    },
    {
      "name": "CSS Classes and IDs",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#EAC645" }
    },
    {
      "name": "CSS Property Names",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#6CB5E8" }
    }
  ]
}
